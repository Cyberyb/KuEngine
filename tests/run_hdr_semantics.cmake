# Fixed fixtures and thresholds are implemented in hdr_pixel_checks.cpp.
if(NOT DEFINED REQUIRE_VALIDATION)
    set(REQUIRE_VALIDATION ON)
endif()
set(validation)
if(REQUIRE_VALIDATION)
    set(validation --smoke-require-validation)
endif()
file(MAKE_DIRECTORY "${EVIDENCE_DIR}")
macro(run_case name)
    execute_process(COMMAND "${APP}" --smoke-frames 3 ${validation}
        --smoke-sidebar-collapsed --deferred-readback-prefix "${EVIDENCE_DIR}/${name}" ${ARGN}
        WORKING_DIRECTORY "${WORKING_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 45)
    file(WRITE "${EVIDENCE_DIR}/${name}.log" "${output}${errors}")
    if(result EQUAL 77)
        message("KUENGINE_HDR_SKIP validation unavailable")
        return()
    endif()
    if(NOT result EQUAL 0 OR output MATCHES "KUENGINE_VALIDATION_ERROR|KUENGINE_SMOKE_FAIL" OR NOT output MATCHES "KUENGINE_HDR_READBACK_OK.*depthUnchanged=1")
        message(FATAL_ERROR "HDR case ${name} failed: ${output} ${errors}")
    endif()
endmacro()
function(check mode first second)
    execute_process(COMMAND "${CHECKER}" "${mode}" "${EVIDENCE_DIR}/${first}_960x540" ${second}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    message("${mode}/${first}: ${output}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${errors}")
    endif()
endfunction()
foreach(path IN ITEMS forward deferred)
    set(path_arg)
    if(path STREQUAL deferred)
        set(path_arg --deferred)
    endif()
    run_case(${path}-hdr ${path_arg} --hdr-fixture)
    run_case(${path}-exposure ${path_arg} --hdr-fixture --display-exposure 2)
    check(analytic ${path}-hdr 1)
    check(analytic ${path}-exposure 2)
    check(exposure ${path}-hdr "${EVIDENCE_DIR}/${path}-exposure_960x540")
    run_case(${path}-normal ${path_arg} --normal-fixture)
    run_case(${path}-semantic ${path_arg})
    run_case(${path}-backface ${path_arg} --forward-reuse-backface)
    run_case(${path}-normal-zero ${path_arg} --normal-fixture --normal-scale 0)
    check(response ${path}-normal "${EVIDENCE_DIR}/${path}-normal-zero_960x540")
    run_case(${path}-sky ${path_arg} --normal-fixture --scene-sky)
    run_case(${path}-environment ${path_arg} --normal-fixture --scene-environment)
    run_case(${path}-both ${path_arg} --normal-fixture --scene-sky --scene-environment)
    check(sky ${path}-normal "${EVIDENCE_DIR}/${path}-sky_960x540")
    check(sky ${path}-environment "${EVIDENCE_DIR}/${path}-both_960x540")
    check(environment ${path}-normal "${EVIDENCE_DIR}/${path}-environment_960x540")
endforeach()
check(compare forward-hdr "${EVIDENCE_DIR}/deferred-hdr_960x540")
check(semantic forward-semantic "${EVIDENCE_DIR}/deferred-semantic_960x540")
check(semantic forward-backface "${EVIDENCE_DIR}/deferred-backface_960x540")
foreach(preset IN ITEMS normal normal-zero sky environment both)
    check(normal forward-${preset} "${EVIDENCE_DIR}/deferred-${preset}_960x540")
endforeach()
message("KUENGINE_HDR_SEMANTICS_OK")
