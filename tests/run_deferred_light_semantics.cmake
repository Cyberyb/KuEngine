if(NOT DEFINED REQUIRE_VALIDATION)
    set(REQUIRE_VALIDATION ON)
endif()
set(validation)
if(REQUIRE_VALIDATION)
    set(validation --smoke-require-validation)
endif()
file(MAKE_DIRECTORY "${EVIDENCE_DIR}")
foreach(preset IN ITEMS scene zero directional point)
    set(args --deferred --smoke-frames 3 ${validation}
        --deferred-readback-prefix "${EVIDENCE_DIR}/${preset}")
    if(preset STREQUAL "zero")
        list(APPEND args --forward-reuse-zero-lights)
    elseif(preset STREQUAL "directional")
        list(APPEND args --forward-reuse-directional-only)
    elseif(preset STREQUAL "point")
        list(APPEND args --forward-reuse-point-only)
    endif()
    execute_process(COMMAND "${APP}" ${args} WORKING_DIRECTORY "${WORKING_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 40)
    file(WRITE "${EVIDENCE_DIR}/${preset}.log" "exit=${result}\n${output}${errors}")
    if(result EQUAL 77)
        message("KUENGINE_DEFERRED_LIGHT_SKIP ${preset}: ${output} ${errors}")
        return()
    endif()
    if(NOT result EQUAL 0 OR output MATCHES "KUENGINE_VALIDATION_ERROR|KUENGINE_SMOKE_FAIL")
        message(FATAL_ERROR "Deferred ${preset} run failed (${result}): ${output} ${errors}")
    endif()
    string(REGEX MATCH "KUENGINE_DEFERRED_PIXELS_OK[^\r\n]*pbrSum=([0-9]+) unlitSum=([0-9]+)" marker "${output}")
    if(NOT marker)
        message(FATAL_ERROR "Missing real GPU pixel evidence for ${preset}: ${output}")
    endif()
    set(pbr_${preset} "${CMAKE_MATCH_1}")
    set(unlit_${preset} "${CMAKE_MATCH_2}")
    message("${preset}: ${marker}")
endforeach()
if(NOT pbr_scene GREATER pbr_zero OR NOT pbr_directional GREATER pbr_zero OR NOT pbr_point GREATER pbr_zero)
    message(FATAL_ERROR "PBR did not respond to both directional and point illumination")
endif()
if(NOT unlit_scene EQUAL unlit_zero OR NOT unlit_directional EQUAL unlit_zero OR NOT unlit_point EQUAL unlit_zero)
    message(FATAL_ERROR "Unlit changed with direct lighting")
endif()
message("KUENGINE_DEFERRED_LIGHT_SEMANTICS_OK: PBR responds to directional/point, Unlit is invariant")
