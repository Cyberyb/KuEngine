# WP03-A permanent finite GPU requests, raw-MRT references and config precedence.
# REQUIRE_VALIDATION=OFF performs real Release GPU work (not a skip).
if(NOT DEFINED REQUIRE_VALIDATION)
    set(REQUIRE_VALIDATION ON)
endif()
set(validation)
if(REQUIRE_VALIDATION)
    set(validation --smoke-require-validation)
endif()
file(MAKE_DIRECTORY "${EVIDENCE_DIR}")
macro(run_path name executable width height kind)
    execute_process(COMMAND "${executable}" --viewer-path-smoke-prefix "${EVIDENCE_DIR}/${name}"
        --smoke-frames 65 ${validation} --smoke-recompile-after-setup ${ARGN}
        WORKING_DIRECTORY "${WORKING_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 90)
    file(WRITE "${EVIDENCE_DIR}/${name}.log" "exit=${result}\n${output}${errors}")
    if(result EQUAL 77)
        message("KUENGINE_PATH_SKIP validation unavailable (exit 77)")
        return()
    endif()
    if(NOT result EQUAL 0 OR output MATCHES "KUENGINE_VALIDATION_ERROR|KUENGINE_SMOKE_FAIL" OR NOT output MATCHES "KUENGINE_PATH_SMOKE_OK samples=25" OR NOT output MATCHES "KUENGINE_COMPLETED_STATS.*status=matched")
        message(FATAL_ERROR "Path case ${name} failed; see ${EVIDENCE_DIR}/${name}.log")
    endif()
    execute_process(COMMAND "${CHECKER}" "${EVIDENCE_DIR}/${name}" ${width} ${height} ${kind}
        RESULT_VARIABLE checked OUTPUT_VARIABLE checks ERROR_VARIABLE checkErrors)
    file(WRITE "${EVIDENCE_DIR}/${name}-checker.log" "exit=${checked}\n${checks}${checkErrors}")
    if(NOT checked EQUAL 0)
        message(FATAL_ERROR "Path checker ${name}: ${checkErrors}")
    endif()
    message("${name}: ${checks}")
endmacro()
run_path(semantic "${APP}" 800 600 semantic --smoke-sidebar-collapsed --smoke-resize-after 2 800 600)
run_path(clamp "${APP}" 960 540 clamp --smoke-sidebar-collapsed --gbuffer-clamp-fixture)
run_path(sidebar "${APP}" 800 600 semantic --smoke-resize-after 2 800 600)
run_path(mclaren "${MCLAREN}" 960 540 mclaren --smoke-resize-after 2 960 540)
run_path(mclaren-replaced "${MCLAREN}" 960 540 mclaren --smoke-resize-after 2 960 540
    --mclaren-replace-model "${SOURCE_DIR}/tests/fixtures/material-semantics.gltf"
    --mclaren-replace-hdr "${SOURCE_DIR}/resources/environments/hdr/citrus_orchard_road_puresky_4k.hdr")
file(READ "${EVIDENCE_DIR}/mclaren-replaced.log" replacement)
if(NOT replacement MATCHES "KUENGINE_ASSET_REPLACE_SUCCESS kind=model" OR NOT replacement MATCHES "KUENGINE_ASSET_REPLACE_SUCCESS kind=hdr")
    message(FATAL_ERROR "Successful model/HDR replacement was not exercised before path switching")
endif()
run_path(mclaren-failed "${MCLAREN}" 960 540 mclaren --smoke-resize-after 2 960 540
    --mclaren-replace-model "${SOURCE_DIR}/tests/fixtures/invalid-replacement.glb"
    --mclaren-replace-hdr "${SOURCE_DIR}/tests/fixtures/invalid-replacement.hdr")
file(READ "${EVIDENCE_DIR}/mclaren-failed.log" replacement)
if(NOT replacement MATCHES "KUENGINE_ASSET_REPLACE_FAIL kind=model.*retained=1" OR NOT replacement MATCHES "KUENGINE_ASSET_REPLACE_FAIL kind=hdr.*retained=1")
    message(FATAL_ERROR "Failed model/HDR replacement retention was not exercised")
endif()

# Resize after two completed F/D pairs, not just before the first baseline.
# Raw-MRT mapping and invariant checks remain active after the extent change;
# pairs are never compared across extents. Projection is viewport-derived,
# while stable camera pose/FOV/speed, assets and parameters remain checked.
foreach(viewer IN ITEMS reuse mclaren)
    set(executable "${APP}")
    if(viewer STREQUAL mclaren)
        set(executable "${MCLAREN}")
    endif()
    execute_process(COMMAND "${executable}" --viewer-path-smoke-prefix "${EVIDENCE_DIR}/${viewer}-late-resize"
        --smoke-frames 65 ${validation} --smoke-resize-after 12 800 600
        WORKING_DIRECTORY "${WORKING_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 90)
    file(WRITE "${EVIDENCE_DIR}/${viewer}-late-resize.log" "exit=${result}\n${output}${errors}")
    if(result EQUAL 77)
        message("KUENGINE_PATH_SKIP validation unavailable (exit 77)")
        return()
    endif()
    if(NOT result EQUAL 0 OR NOT output MATCHES "KUENGINE_PATH_SMOKE_OK samples=25" OR NOT output MATCHES "KUENGINE_PATH_LAYOUT_CHANGED" OR output MATCHES "KUENGINE_VALIDATION_ERROR|KUENGINE_SMOKE_FAIL")
        message(FATAL_ERROR "Late resize ${viewer} failed; see log")
    endif()
endforeach()

# Isolated configuration working directories; never edit the real source/bin
# SceneConfig and never overwrite another configuration's runtime/evidence.
foreach(viewer IN ITEMS reuse mclaren)
    set(runtime "${EVIDENCE_DIR}/config-${viewer}")
    file(MAKE_DIRECTORY "${runtime}/resources")
    file(COPY "${WORKING_DIR}/shaders" DESTINATION "${runtime}")
    if(viewer STREQUAL reuse)
        set(executable "${APP}")
        file(COPY "${WORKING_DIR}/resources/forward_reuse" DESTINATION "${runtime}/resources")
        set(config "${runtime}/resources/forward_reuse/forward-reuse.scene.json")
        file(READ "${config}" original)
    else()
        set(executable "${MCLAREN}")
        file(MAKE_DIRECTORY "${runtime}/resources/scenes/sandbox")
        set(config "${runtime}/resources/scenes/sandbox/mclaren-sandbox.scene.json")
        file(READ "${SOURCE_DIR}/resources/scenes/sandbox/mclaren-sandbox.scene.json" original)
        string(JSON count LENGTH "${original}" nodes)
        math(EXPR last "${count}-1")
        foreach(n RANGE 0 ${last})
            foreach(field IN ITEMS model material)
                string(JSON value ERROR_VARIABLE error GET "${original}" nodes ${n} ${field})
                if(NOT error AND NOT value STREQUAL "")
                    string(JSON original SET "${original}" nodes ${n} ${field} "\"${SOURCE_DIR}/resources/${value}\"")
                endif()
            endforeach()
        endforeach()
        string(JSON original SET "${original}" environment "\"${SOURCE_DIR}/resources/environments/hdr/citrus_orchard_road_puresky_4k.hdr\"")
    endif()
    foreach(case IN ITEMS deferred override-forward invalid)
        set(cli)
        set(expected 0)
        set(path deferred)
        if(case STREQUAL invalid)
            set(path typo)
            set(expected 1)
        elseif(case STREQUAL override-forward)
            set(cli --render-path forward)
        endif()
        string(JSON json SET "${original}" renderPath "\"${path}\"")
        file(WRITE "${config}" "${json}")
        execute_process(COMMAND "${executable}" --smoke-frames 3 ${validation} ${cli}
            WORKING_DIRECTORY "${runtime}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 45)
        file(WRITE "${EVIDENCE_DIR}/config-${viewer}-${case}.log" "exit=${result}\n${output}${errors}")
        if(result EQUAL 77)
            message("KUENGINE_PATH_SKIP validation unavailable (exit 77)")
            return()
        endif()
        if(NOT result EQUAL expected OR output MATCHES "KUENGINE_VALIDATION_ERROR")
            message(FATAL_ERROR "SceneConfig ${viewer}/${case} result=${result} expected=${expected}")
        endif()
        if(expected EQUAL 1 AND NOT "${output}${errors}" MATCHES "RenderPath must be")
            message(FATAL_ERROR "Invalid config failed for an unrelated reason: ${output}${errors}")
        endif()
        if(expected EQUAL 0)
            if(case STREQUAL override-forward)
                set(path forward)
            endif()
            if(NOT output MATCHES "KUENGINE_PATH_PUBLISHED path=${path} view=0 generation=1")
                message(FATAL_ERROR "SceneConfig ${viewer}/${case} was not applied by the real Source")
            endif()
        endif()
    endforeach()
    foreach(option IN ITEMS conflict illegal missing)
        set(cli --deferred --render-path forward)
        if(option STREQUAL illegal)
            set(cli --render-path DEFERRED)
        elseif(option STREQUAL missing)
            set(cli --render-path)
        endif()
        execute_process(COMMAND "${executable}" ${cli} WORKING_DIRECTORY "${WORKING_DIR}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
        file(WRITE "${EVIDENCE_DIR}/cli-${viewer}-${option}.log" "exit=${result}\n${output}${errors}")
        if(NOT result EQUAL 2 OR NOT errors MATCHES "KUENGINE_ARGUMENT_ERROR")
            message(FATAL_ERROR "CLI ${viewer}/${option} did not reject before initialization")
        endif()
    endforeach()
endforeach()
message("KUENGINE_VIEWER_PATHS_OK")
