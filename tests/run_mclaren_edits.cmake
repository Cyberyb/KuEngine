# Configuration-isolated B verification. OFF means real GPU, not skip.
if(NOT DEFINED REQUIRE_VALIDATION)
    set(REQUIRE_VALIDATION ON)
endif()
set(validation)
if(REQUIRE_VALIDATION)
    set(validation --smoke-require-validation)
endif()
file(MAKE_DIRECTORY "${EVIDENCE_DIR}")
foreach(layout IN ITEMS sidebar collapsed)
    set(extra)
    if(layout STREQUAL collapsed)
        set(extra --smoke-sidebar-collapsed)
    endif()
    execute_process(COMMAND "${APP}" --scene "${SOURCE_DIR}/tests/fixtures/viewer-two-instances.scene.json"
        --mclaren-edit-smoke-prefix "${EVIDENCE_DIR}/${layout}" --smoke-frames 90 ${validation} ${extra}
        --smoke-resize-after 54 800 600 --smoke-recompile-after-setup
        WORKING_DIRECTORY "${WORKING_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    file(WRITE "${EVIDENCE_DIR}/${layout}.log" "exit=${result}\n${output}${errors}")
    if(result EQUAL 77)
        message("KUENGINE_EDIT_SKIP validation unavailable exit77")
        return()
    endif()
    if(NOT result EQUAL 0 OR output MATCHES "KUENGINE_VALIDATION_ERROR|KUENGINE_SMOKE_FAIL" OR NOT output MATCHES "KUENGINE_EDIT_SMOKE_OK samples=29 edits=16 instances=2" OR NOT output MATCHES "KUENGINE_EDIT_RECOMPILE_AFTER_CLEAR" OR NOT output MATCHES "KUENGINE_COMPLETED_STATS.*status=matched")
        message(FATAL_ERROR "Edit lifecycle ${layout} failed: ${EVIDENCE_DIR}/${layout}.log")
    endif()
    execute_process(COMMAND "${CHECKER}" "${EVIDENCE_DIR}/${layout}" RESULT_VARIABLE checked OUTPUT_VARIABLE checks ERROR_VARIABLE checkErrors)
    file(WRITE "${EVIDENCE_DIR}/${layout}-checker.log" "exit=${checked}\n${checks}${checkErrors}")
    if(NOT checked EQUAL 0)
        message(FATAL_ERROR "Edit checker ${layout} failed: ${checkErrors}")
    endif()
    message("${layout}: ${checks}")
endforeach()
foreach(bad IN ITEMS missing.scene.json render-path-invalid.json viewer-bad-model.scene.json viewer-bad-hdr.scene.json viewer-empty-node.scene.json)
    execute_process(COMMAND "${APP}" --scene "${SOURCE_DIR}/tests/fixtures/${bad}" --smoke-frames 2 ${validation}
        WORKING_DIRECTORY "${WORKING_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 40)
    file(WRITE "${EVIDENCE_DIR}/strict-${bad}.log" "exit=${result}\n${output}${errors}")
    if(NOT result EQUAL 1 OR NOT "${output}${errors}" MATCHES "KUENGINE_SMOKE_FAIL reason=initialization")
        message(FATAL_ERROR "Explicit scene ${bad} did not fail strictly: exit ${result}")
    endif()
endforeach()
